---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
}
const { eyebrow, title, lead, align = "left" } = Astro.props;
---

<header class:list={["section-heading", { "section-heading--center": align === "center" }]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {lead && <p class="section-lead">{lead}</p>}
</header>

<style>
  .section-heading--center {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .section-heading--center .section-lead {
    margin-inline: auto;
  }
</style>
