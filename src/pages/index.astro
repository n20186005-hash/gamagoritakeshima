    color: #9d3627;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .fact-item strong {
    color: #173b57;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 600;
  }

  .fact-item span {
    margin-top: 0.18rem;
    color: rgb(34 38 34 / 0.5);
    font-size: 0.68rem;
  }

  .today-section {
    padding-bottom: 0;
  }

  .today-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr 0.9fr;
    gap: clamp(1.8rem, 5vw, 4.5rem);
    align-items: center;
    padding: clamp(1.6rem, 4vw, 3.4rem);
  }

  .today-card__intro h2 {
    margin-top: 0.85rem;
    margin-bottom: 0;
    color: #173b57;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .today-card__status {
    border-left: 1px solid rgb(23 59 87 / 0.13);
    padding-left: clamp(1.5rem, 3vw, 3rem);
  }

  .today-date {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgb(34 38 34 / 0.52);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .today-date__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #315848;
    box-shadow: 0 0 0 5px rgb(49 88 72 / 0.1);
  }

  .today-label {
    margin-top: 0.8rem;
    margin-bottom: 0.5rem;
    color: #29493d;
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 600;
  }

  .today-copy {
    margin-bottom: 0;
    color: rgb(34 38 34 / 0.64);
    font-size: 0.78rem;
    line-height: 1.9;
  }

  .today-card__checks {
    display: grid;
  }

  .today-card__checks a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    border-bottom: 1px solid rgb(23 59 87 / 0.1);
    padding: 0.7rem 0;
    color: #173b57;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .today-card__checks a:last-child {
    border-bottom: 0;
  }

  .today-card__checks span {
    color: #b74632;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .today-note {
    margin-top: 0.7rem;
    margin-bottom: 0;
    color: rgb(34 38 34 / 0.45);
    font-size: 0.65rem;
    text-align: right;
  }

  .story-section {
    overflow: hidden;
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.85fr);
    gap: clamp(3rem, 9vw, 8rem);
    align-items: center;
  }

  .story-image-wrap {
    position: relative;
    padding-right: clamp(0rem, 5vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 5vw, 4rem);
  }

  .story-image-main {
    height: clamp(430px, 62vw, 720px);
    border-radius: 12rem 12rem 1.5rem 1.5rem;
  }

  .story-image-main img {
    object-position: 48% center;
  }

  .story-stamp {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    width: clamp(120px, 15vw, 180px);
    aspect-ratio: 1;
    place-content: center;
    border: 1px solid rgb(183 70 50 / 0.42);
    border-radius: 50%;
    background: #f3efe5;
    color: #9d3627;
    text-align: center;
    transform: rotate(-6deg);
  }

  .story-stamp::before,
  .story-stamp::after {
    position: absolute;
    inset: 8px;
    border: 1px dashed rgb(183 70 50 / 0.34);
    border-radius: inherit;
    content: "";
  }

  .story-stamp::after {
    inset: 15px;
    border-style: solid;
  }

  .story-stamp span {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    letter-spacing: 0.15em;
  }

  .story-stamp small {
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .story-body {
    margin-top: 1.4rem;
    margin-bottom: 1.9rem;
    color: rgb(34 38 34 / 0.68);
    line-height: 2.1;
  }

  .highlights-section {
    background: #e9eee9;
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem) clamp(1.5rem, 4vw, 3.5rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .highlight-card:nth-child(even) {
    margin-top: clamp(2rem, 7vw, 6rem);
  }

  .highlight-card__image {
    height: clamp(300px, 45vw, 560px);
  }

  .highlight-card__number {
    position: absolute;
    z-index: 2;
    top: 1.1rem;
    left: 1.1rem;
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border-radius: 50%;
    background: rgb(250 248 242 / 0.9);
    color: #173b57;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    backdrop-filter: blur(8px);
  }

  .highlight-card__copy {
    position: relative;
    padding: 1.5rem 4rem 0 0.2rem;
  }

  .highlight-card__copy > p {
    margin-bottom: 0.4rem;
    color: #9d3627;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .highlight-card__copy h3 {
    margin-bottom: 0.7rem;
    color: #173b57;
    font-family: var(--serif);
    font-size: clamp(1.65rem, 3vw, 2.6rem);
    font-weight: 500;
  }

  .highlight-card__copy > span {
    display: block;
    max-width: 38rem;
    color: rgb(34 38 34 / 0.62);
    font-size: 0.84rem;
    line-height: 1.95;
  }

  .highlight-card__copy svg {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    width: 2.8rem;
    color: #173b57;
    transition: transform 180ms ease, color 180ms ease;
  }

  .highlight-card:hover .highlight-card__copy svg {
    color: #b74632;
    transform: translateX(4px);
  }

  .route-section {
    background: #173b57;
    color: white;
  }

  .route-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .route-heading {
    position: sticky;
    top: calc(var(--header-height) + 3rem);
  }

  .route-heading :global(.eyebrow) {
    color: #e7b7a9;
  }

  .route-heading :global(.section-title) {
    color: white;
  }

  .route-heading :global(.section-lead) {
    color: rgb(255 255 255 / 0.65);
  }

  .route-heading > a {
    margin-top: 2rem;
    border-color: white;
    background: white;
    color: #173b57;
  }

  .route-heading > a:hover {
    background: #f3efe5;
  }

  .route-cards {
    display: grid;
    gap: 1.35rem;
  }

  .route-card {
    display: grid;
    grid-template-columns: minmax(170px, 0.75fr) minmax(0, 1.25fr);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.06);
    transition: transform 200ms ease, background-color 200ms ease;
  }

  .route-card:hover {
    transform: translateX(5px);
    background: rgb(255 255 255 / 0.1);
  }

  .route-card__image {
    min-height: 250px;
    overflow: hidden;
  }

  .route-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .route-card:hover img {
    transform: scale(1.035);
  }

  .route-card__body {
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 3.2vw, 2.7rem);
  }

  .route-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgb(255 255 255 / 0.55);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .route-card__meta strong {
    color: #b9d7e1;
  }

  .route-card h3 {
    margin-top: 1rem;
    margin-bottom: 0.75rem;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    font-weight: 500;
  }

  .route-card p {
    margin-bottom: 1.4rem;
    color: rgb(255 255 255 / 0.6);
    font-size: 0.82rem;
    line-height: 1.9;
  }

  .route-card__link {
    margin-top: auto;
    color: white;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .route-card__link b {
    margin-left: 0.5rem;
    color: #e7b7a9;
  }

  .photo-section {
    overflow: hidden;
  }

  .photo-layout {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(3.5rem, 9vw, 8rem);
    align-items: center;
  }

  .photo-tips {
    display: grid;
    gap: 0;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .photo-tips li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    border-top: 1px solid rgb(23 59 87 / 0.12);
    padding: 0.75rem 0;
    color: rgb(34 38 34 / 0.66);
    font-size: 0.82rem;
  }

  .photo-tips li:last-child {
    border-bottom: 1px solid rgb(23 59 87 / 0.12);
  }

  .photo-tips span {
    color: #b74632;
    font-family: var(--serif);
    font-size: 1rem;
  }

  .photo-collage {
    position: relative;
    min-height: clamp(520px, 63vw, 760px);
  }

  .photo-collage__main {
    position: absolute;
    top: 0;
    right: 0;
    width: 82%;
    height: 68%;
    border-radius: 1.5rem 12rem 1.5rem 1.5rem;
  }

  .photo-collage__sub {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 53%;
    height: 48%;
    border: 8px solid #f3efe5;
  }

  .photo-collage__caption {
    position: absolute;
    right: -0.2rem;
    bottom: 4%;
    color: rgb(23 59 87 / 0.46);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    writing-mode: vertical-rl;
  }

  .aquarium-section {
    background: #e4eff2;
  }

  .aquarium-card {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .aquarium-images {
    position: relative;
    min-height: clamp(490px, 55vw, 680px);
    padding-bottom: 4rem;
  }

  .aquarium-images__main {
    position: absolute;
    top: 0;
    right: 8%;
    left: 0;
    height: 82%;
    border-radius: 10rem 1.5rem 1.5rem 1.5rem;
  }

  .aquarium-images__sub {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 43%;
    height: 40%;
    border: 8px solid #e4eff2;
  }

  .aquarium-copy > p:not(.eyebrow):not(.aquarium-note) {
    margin-top: 1.6rem;
    color: rgb(34 38 34 / 0.68);
    line-height: 2;
  }

  .aquarium-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 1.8rem 0 1rem;
    border-top: 1px solid rgb(23 59 87 / 0.15);
    border-bottom: 1px solid rgb(23 59 87 / 0.15);
  }

  .aquarium-facts div {
    padding: 1rem 0.8rem;
    border-right: 1px solid rgb(23 59 87 / 0.12);
  }

  .aquarium-facts div:first-child {
    padding-left: 0;
  }

  .aquarium-facts div:last-child {
    border-right: 0;
  }

  .aquarium-facts dt {
    color: rgb(34 38 34 / 0.48);
    font-size: 0.64rem;
    font-weight: 800;
  }

  .aquarium-facts dd {
    margin: 0.25rem 0 0;
    color: #173b57;
    font-family: var(--serif);
    font-size: 1.02rem;
  }

  .aquarium-note {
    margin-bottom: 1.7rem;
    color: rgb(34 38 34 / 0.48);
    font-size: 0.65rem;
    line-height: 1.8;
  }

  .food-section {
    background: #f8f4eb;
  }

  .food-heading-row,
  .access-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .food-heading-row :global(.section-heading),
  .access-heading-row :global(.section-heading) {
    max-width: 750px;
  }

  .food-heading-row > a,
  .access-actions {
    flex: 0 0 auto;
    margin-bottom: 0.3rem;
  }

  .food-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .food-card {
    position: relative;
    display: flex;
    min-height: 420px;
    flex-direction: column;
    border: 1px solid rgb(23 59 87 / 0.1);
    border-radius: 1.5rem;
    background: #faf8f2;
    padding: clamp(1.6rem, 3vw, 2.5rem);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .food-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-paper);
  }

  .food-card__number {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    color: rgb(23 59 87 / 0.14);
    font-family: var(--serif);
    font-size: 3.4rem;
    line-height: 1;
  }

  .food-card__category {
    margin-bottom: 1.6rem;
    color: #b74632;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .food-card h3 {
    max-width: 12ch;
    margin-bottom: 0.7rem;
    color: #173b57;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.45;
  }

  .food-card strong {
    color: #29493d;
    font-size: 0.82rem;
  }

  .food-card > p:not(.food-card__category) {
    margin-top: 1rem;
    margin-bottom: 1.4rem;
    color: rgb(34 38 34 / 0.62);
    font-size: 0.78rem;
    line-height: 1.9;
  }

  .food-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .food-card__tags span {
    border: 1px solid rgb(23 59 87 / 0.12);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    color: rgb(23 59 87 / 0.62);
    font-size: 0.62rem;
  }

  .access-section {
    background: #eef0e8;
  }

  .access-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .access-section :global(.local-map) {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .access-quick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.2rem;
    border: 1px solid rgb(23 59 87 / 0.1);
    border-radius: 1.25rem;
    background: rgb(250 248 242 / 0.68);
  }

  .access-quick-grid article {
    border-right: 1px solid rgb(23 59 87 / 0.1);
    padding: 1.4rem 1.6rem;
  }

  .access-quick-grid article:last-child {
    border-right: 0;
  }

  .access-quick-grid span {
    color: #b74632;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .access-quick-grid h3 {
    margin: 0.4rem 0 0.3rem;
    color: #173b57;
    font-family: var(--serif);
    font-size: 1.1rem;
  }

  .access-quick-grid p {
    margin: 0;
    color: rgb(34 38 34 / 0.58);
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .final-cta {
    position: relative;
    min-height: clamp(520px, 74vw, 760px);
    overflow: hidden;
    background: #102c40;
    color: white;
  }

  .final-cta > img,
  .final-cta__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .final-cta > img {
    object-fit: cover;
  }

  .final-cta__overlay {
    background: linear-gradient(90deg, rgb(7 25 38 / 0.82), rgb(7 25 38 / 0.22)), linear-gradient(0deg, rgb(7 25 38 / 0.5), transparent);
  }

  .final-cta__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: clamp(520px, 74vw, 760px);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .final-cta__content > p {
    margin-bottom: 1.2rem;
    color: rgb(255 255 255 / 0.58);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.25em;
  }

  .final-cta__content h2 {
    margin-bottom: 2rem;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    font-weight: 500;
    line-height: 1.28;
  }

  .final-cta__content > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .final-cta__primary {
    border-color: white;
    background: white;
    color: #173b57;
  }

  .final-cta__secondary {
    border-color: rgb(255 255 255 / 0.38);
    background: rgb(16 44 64 / 0.18);
    color: white;
  }

  @media (max-width: 980px) {
    .facts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact-item:nth-child(2) {
      border-right: 1px solid rgb(23 59 87 / 0.1);
    }

    .fact-item:nth-child(n + 3) {
      border-top: 1px solid rgb(23 59 87 / 0.1);
    }

    .today-card {
      grid-template-columns: 1fr 1fr;
    }

    .today-card__checks {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid rgb(23 59 87 / 0.1);
      padding-top: 1rem;
    }

    .today-card__checks a {
      border-right: 1px solid rgb(23 59 87 / 0.1);
      border-bottom: 0;
      padding-inline: 1rem;
    }

    .today-card__checks a:first-child { padding-left: 0; }
    .today-card__checks a:last-child { border-right: 0; }

    .story-grid,
    .photo-layout,
    .aquarium-card {
      grid-template-columns: 1fr;
    }

    .story-image-wrap {
      max-width: 720px;
    }

    .story-copy,
    .photo-copy,
    .aquarium-copy {
      max-width: 720px;
    }

    .route-layout {
      grid-template-columns: 1fr;
    }

    .route-heading {
      position: static;
      max-width: 720px;
    }

    .food-heading-row,
    .access-heading-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .food-grid {
      grid-template-columns: 1fr 1fr;
    }

    .food-card:last-child {
      grid-column: 1 / -1;
      min-height: 330px;
    }
  }

  @media (max-width: 700px) {
    .home-hero {
      min-height: 760px;
    }

    .home-hero__image {
      object-position: 61% center;
    }

    .home-hero__shade {
      background: linear-gradient(0deg, rgb(7 25 38 / 0.87) 0%, rgb(7 25 38 / 0.42) 70%, rgb(7 25 38 / 0.25));
    }

    .home-hero__inner {
      min-height: 760px;
      grid-template-columns: 1fr;
      align-items: flex-end;
      padding-bottom: 8.8rem;
    }

    .home-hero__copy {
      padding-top: 7rem;
    }

    .home-hero h1,
    .home-hero .hero-title {
      font-size: clamp(3.1rem, 15vw, 5.3rem);
    }

    .home-hero h1 span,
    .home-hero .hero-title span {
      padding-left: 0.55rem;
    }

    .home-hero__side {
      display: none;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions a {
      width: 100%;
    }

    .facts-grid {
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }

    .fact-item {
      min-height: 130px;
      padding-inline: 1.1rem;
    }

    .fact-item:first-child,
    .fact-item:nth-child(3) {
      border-left: 0;
    }

    .today-card {
      grid-template-columns: 1fr;
      border-radius: 1.2rem;
    }

    .today-card__status {
      border-top: 1px solid rgb(23 59 87 / 0.1);
      border-left: 0;
      padding-top: 1.3rem;
      padding-left: 0;
