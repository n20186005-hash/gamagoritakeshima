---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import LocalMap from "../components/LocalMap.astro";
import Reviews from "../components/Reviews.astro";
import Weather from "../components/Weather.astro";
import Facilities from "../components/Facilities.astro";
import Seasonal from "../components/Seasonal.astro";
import Itineraries from "../components/Itineraries.astro";
import Responsibility from "../components/Responsibility.astro";
import Sources from "../components/Sources.astro";
import { courses, highlights, quickFacts, restaurants, site, homeFaq } from "../data/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    alternateName: site.legalName,
    url: site.url,
    inLanguage: "ja-JP",
    description: site.description
  },
  {
    "@context": "https://schema.org",
    "@type": ["TouristAttraction", "Park"],
    "@id": `${site.url}/#attraction`,
    name: "竹島園地",
    alternateName: ["Takeshima Garden", "Takeshima", "Gamagori Takeshima"],
    description: "愛知県蒲郡市、竹島と竹島橋を望む海辺の園地。八百富神社と竹島水族館を含む蒲郡の観光エリアの入口。",
    image: [`${site.url}/images/og-image.jpg`],
    url: site.url,
    isAccessibleForFree: true,
    publicAccess: true,
    address: {
      "@type": "PostalAddress",
      postalCode: site.attraction.postalCode,
      addressRegion: "愛知県",
      addressLocality: "蒲郡市",
      streetAddress: site.streetAddress,
      addressCountry: site.attraction.countryCode
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: site.coordinates.latitude,
      longitude: site.coordinates.longitude
    },
    hasMap: site.maps.shareUrl,
    sameAs: [
      site.maps.placeUrl,
      site.official.cityUrl,
      site.official.prefTourismUrl
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homeFaq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<BaseLayout
  jsonLd={jsonLd}
  title="竹島園地・竹島観光ガイド｜駐車場・アクセス・見どころ【蒲郡】"
  description="愛知県蒲郡市の竹島園地・竹島観光ガイド。竹島橋や八百富神社の見どころ、駐車場の料金、蒲郡駅からのアクセス、所要時間、周辺ランチ、モデルコースを紹介します。"
>
  <h1 class="sr-only">竹島園地（蒲郡）｜観光ガイド・アクセス・天気・口コミ</h1>
  <section class="home-hero" aria-labelledby="hero-title">
    <img class="home-hero__image" src="/images/hero-aerial.webp" alt="高台から見た竹島と竹島橋、三河湾" fetchpriority="high" />
    <div class="home-hero__shade"></div>
    <div class="container-site home-hero__inner">
      <div class="home-hero__copy">
        <p class="hero-kicker">竹島園地・竹島観光ガイド｜蒲郡</p>
        <p id="hero-title" class="hero-title">海を渡って、<br /><span>島の時間へ。</span></p>
        <p class="hero-lead">竹島園地から始まる、<br class="hidden sm:block" />海と緑と祈りの小さな旅。</p>
        <div class="hero-actions">
          <a class="btn-primary hero-primary" href="/highlights/">
            見どころを歩く
            <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a class="btn-secondary hero-secondary" href="/courses/">旅の時間から選ぶ</a>
        </div>
      </div>
      <div class="home-hero__side" aria-hidden="true">
        <p class="vertical-label">三河湾の海風と、島を包む緑。</p>
        <span class="hero-coordinate">34.8151° N<br />137.2335° E</span>
      </div>
    </div>
    <div class="hero-bottom">
      <div class="container-site hero-bottom__inner">
        <span>TAKESHIMA ENCHI</span>
        <a href="#today" aria-label="今日の竹島へスクロール">
          <span>SCROLL</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M7 14l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="facts-bar" aria-label="竹島園地の基本情報">
    <div class="container-site facts-grid">
      {quickFacts.map((fact, index) => (
        <article class="fact-item" data-reveal data-reveal-delay={String(index % 4)}>
          <p>{fact.label}</p>
          <strong>{fact.value}</strong>
          <span>{fact.note}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section-space-sm today-section" id="today">
    <div class="container-site today-card paper-card" data-reveal>
      <div class="today-card__intro">
        <p class="eyebrow">TODAY'S TAKESHIMA</p>
        <h2>今日の竹島を、<br />気持ちよく歩くために。</h2>
      </div>
      <div class="today-card__status">
        <div class="today-date">
          <span class="today-date__dot" aria-hidden="true"></span>
          <span data-today-date>本日</span>
        </div>
        <p class="today-label" data-today-label>海辺の散歩日和</p>
        <p class="today-copy" data-today-copy>風と足元を確かめながら、園地からゆっくり歩き始めましょう。</p>
      </div>
      <div class="today-card__checks">
        <a href="/access/#before-you-go"><span>01</span>風・雨・足元</a>
        <a href="/access/#parking"><span>02</span>駐車場と行事</a>
        <a href="/courses/"><span>03</span>滞在時間</a>
      </div>
    </div>
    <p class="container-site today-note">※天候や営業状況の自動取得ではありません。現地の案内と当日の気象情報を必ずご確認ください。</p>
  </section>

  <section class="section-space story-section">
    <div class="container-site story-grid">
      <div class="story-image-wrap" data-reveal>
        <div class="image-frame story-image-main">
          <img src="/images/bridge-walk.webp" alt="海の上に伸びる竹島橋を歩く人々" loading="lazy" />
        </div>
        <div class="story-stamp" aria-hidden="true">
          <span>竹島</span>
          <small>海と祈り</small>
        </div>
      </div>
      <div class="story-copy">
        <p class="eyebrow" data-reveal>ABOUT TAKESHIMA</p>
        <h2 class="section-title" data-reveal data-reveal-delay="1">景色を見るだけでなく、<br />海を渡って会いにいく。</h2>
        <p class="section-lead" data-reveal data-reveal-delay="2">
          竹島園地から見えるのは、三河湾に浮かぶ緑の小島。387メートルの橋を歩くと、潮の匂いと風の音が近づき、やがて八百富神社の社叢へ入ります。
        </p>
        <p class="story-body" data-reveal data-reveal-delay="3">
          芝生で海を眺める時間、橋の上の開放感、石段の先の静けさ、島の外周で出会う岩礁。短い距離のなかで風景が何度も切り替わることが、竹島散歩の魅力です。
        </p>
        <a class="btn-ghost" href="/highlights/" data-reveal>
          竹島の物語と見どころ
          <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section-space highlights-section">
    <div class="container-site">
      <SectionHeading
        eyebrow="FOUR SCENES"
        title="四つの風景を、ゆっくりつなぐ。"
        lead="園地から島の自然まで、それぞれの場所に立ち止まる理由があります。はじめての竹島は、この四景から。"
      />
      <div class="highlight-grid">
        {highlights.map((item, index) => (
          <a class="highlight-card" href={item.href} data-reveal data-reveal-delay={String(index % 2)}>
            <div class="image-frame highlight-card__image">
              <img src={item.image} alt={item.alt} loading="lazy" />
              <span class="highlight-card__number">{item.number}</span>
            </div>
            <div class="highlight-card__copy">
              <p>{item.subtitle}</p>
              <h3>{item.title}</h3>
              <span>{item.description}</span>
              <svg viewBox="0 0 42 42" aria-hidden="true"><circle cx="21" cy="21" r="20" fill="none" stroke="currentColor" stroke-opacity=".25"></circle><path d="M13 21h16M24 16l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space route-section">
    <div class="container-site route-layout">
      <div class="route-heading">
        <SectionHeading
          eyebrow="MODEL COURSES"
          title="旅の時間から、歩き方を選ぶ。"
          lead="一時間の散歩、親子の半日、夕景を待つ午後。予定と天候に合わせて、無理のないコースを選べます。"
        />
        <a class="btn-primary" href="/courses/">
          すべてのコースを見る
          <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
      <div class="route-cards">
        {courses.map((course, index) => (
          <a class="route-card" href={`/courses/#${course.id}`} data-reveal data-reveal-delay={String(index)}>
            <div class="route-card__image">
              <img src={course.image} alt={`${course.title}のイメージ`} loading="lazy" />
            </div>
            <div class="route-card__body">
              <div class="route-card__meta"><span>{course.label}</span><strong>{course.duration}</strong></div>
              <h3>{course.title}</h3>
              <p>{course.summary}</p>
              <span class="route-card__link">コースを見る <b>→</b></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space photo-section">
    <div class="container-site photo-layout">
      <div class="photo-copy">
        <p class="eyebrow" data-reveal>PHOTOGRAPHY</p>
        <h2 class="section-title" data-reveal>空と海のあいだに、<br />今日だけの竹島。</h2>
        <p class="section-lead" data-reveal>
          朝の澄んだ光、夕暮れの輪郭、橋の灯りが浮かぶ青い時間。三河湾の天気と潮の表情が、同じ構図を少しずつ変えてくれます。
        </p>
        <ul class="photo-tips" data-reveal>
          <li><span>朝</span>人の少ない静かな園地と、やわらかな光</li>
          <li><span>夕</span>橋と島の輪郭、変化する空の色</li>
          <li><span>夜</span>足元と帰路を確かめて、灯りを短時間で</li>
        </ul>
        <a class="btn-secondary" href="/photography/">撮影スポットとマナー</a>
      </div>
      <div class="photo-collage" data-reveal>
        <figure class="photo-collage__main image-frame">
          <img src="/images/takeshima-distance.webp" alt="海と空の間に浮かぶ竹島の遠景" loading="lazy" />
        </figure>
        <figure class="photo-collage__sub image-frame">
          <img src="/images/torii-bridge.webp" alt="鳥居の先に伸びる竹島橋" loading="lazy" />
        </figure>
        <span class="photo-collage__caption">LIGHT · WIND · TIDE</span>
      </div>
    </div>
  </section>

  <section class="section-space aquarium-section">
    <div class="container-site aquarium-card">
      <div class="aquarium-images" data-reveal>
        <div class="image-frame aquarium-images__main">
          <img src="/images/aquarium-crab.webp" alt="竹島水族館のカニの展示" loading="lazy" />
        </div>
        <div class="image-frame aquarium-images__sub">
          <img src="/images/aquarium-goldfish.webp" alt="竹島水族館の金魚" loading="lazy" />
        </div>
      </div>
      <div class="aquarium-copy">
        <p class="eyebrow" data-reveal>WITH THE AQUARIUM</p>
        <h2 class="section-title" data-reveal>海のそばで、<br />海の生きものに会う。</h2>
        <p data-reveal>
          竹島水族館は園地のすぐ近く。深海生物や個性豊かな手書き解説で知られ、天候が変わりやすい日や親子旅にも組み込みやすい場所です。
        </p>
        <dl class="aquarium-facts" data-reveal>
          <div><dt>開館</dt><dd>9:00〜17:00</dd></div>
          <div><dt>最終入館</dt><dd>16:30</dd></div>
          <div><dt>目安</dt><dd>60〜90分</dd></div>
        </dl>
        <p class="aquarium-note">※臨時休館・料金改定・混雑時の運用は現地の最新案内をご確認ください。</p>
        <a class="btn-primary" href="/courses/#family">水族館と巡る半日コース</a>
      </div>
    </div>
  </section>

  <section class="section-space food-section">
    <div class="container-site">
      <div class="food-heading-row">
        <SectionHeading
          eyebrow="TASTE OF GAMAGORI"
          title="海辺のあとに、蒲郡の味。"
          lead="あさりのうどん、三河湾の魚、景色を眺めるホテルランチ。旅の気分と予算で選べる周辺の食事処です。"
        />
        <a class="btn-secondary" href="/food/">周辺グルメをすべて見る</a>
      </div>
      <div class="food-grid">
        {restaurants.slice(0, 3).map((restaurant, index) => (
          <article class="food-card" data-reveal data-reveal-delay={String(index)}>
            <span class="food-card__number">0{index + 1}</span>
            <p class="food-card__category">{restaurant.category}</p>
            <h3>{restaurant.name}</h3>
            <strong>{restaurant.lead}</strong>
            <p>{restaurant.description}</p>
            <div class="food-card__tags">
              {restaurant.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space access-section">
    <div class="container-site">
      <div class="access-heading-row">
        <SectionHeading
          eyebrow="ACCESS"
          title="駅から海へ、約十五分。"
          lead="JR蒲郡駅南口から歩いて竹島園地へ。水族館、園地、橋、島が近い距離にまとまり、徒歩で巡りやすいエリアです。"
        />
        <div class="access-actions">
          <a class="btn-primary" href="/access/">交通・駐車場の詳細</a>
          <button class="btn-secondary" type="button" data-copy-value={site.address}>住所をコピー</button>
        </div>
      </div>
      <div data-reveal><LocalMap /></div>
      <div class="access-quick-grid">
        <article data-reveal><span>TRAIN</span><h3>名古屋から</h3><p>JR東海道本線で蒲郡駅へ。快速利用で約45分が目安。</p></article>
        <article data-reveal data-reveal-delay="1"><span>WALK</span><h3>蒲郡駅から</h3><p>南口から徒歩約15分。バス約5分、タクシー約3分。</p></article>
        <article data-reveal data-reveal-delay="2"><span>CAR</span><h3>車で</h3><p>音羽蒲郡IC方面から約15〜20分。繁忙日は時間に余裕を。</p></article>
      </div>
    </div>
  </section>

  <Reviews />
  <Weather />
  <Facilities />
  <Seasonal />
  <Itineraries />
  <Responsibility />

  <section class="section-space home-faq-section" id="faq" aria-labelledby="home-faq-title">
    <div class="container-site">
      <SectionHeading
        eyebrow="FAQ"
        title="出発前によくある質問。"
        lead="料金、アクセス、天候、歩きやすさ。現地の案内と当日の状況を優先しつつ、事前に知っておきたいことをまとめました。"
      />
      <div class="home-faq-list container-narrow">
        {homeFaq.map((item, index) => (
          <details data-reveal>
            <summary>
              <span>Q{String(index + 1).padStart(2, "0")}</span>
              <strong>{item.question}</strong>
              <i aria-hidden="true"></i>
            </summary>
            <div class="home-faq-answer"><span>A</span><p>{item.answer}</p></div>
          </details>
        ))}
        <p class="home-faq-more">
          <a class="btn-secondary" href="/faq/">すべてのよくある質問を見る</a>
        </p>
      </div>
    </div>
  </section>

  <Sources />

  <section class="final-cta">
    <img src="/images/bridge-wide.webp" alt="海にまっすぐ伸びる竹島橋" loading="lazy" />
    <div class="final-cta__overlay"></div>
    <div class="container-site final-cta__content" data-reveal>
      <p>TAKESHIMA, GAMAGORI</p>
      <h2>海風の向こうへ、<br />一歩ずつ。</h2>
      <div>
        <a class="btn-primary final-cta__primary" href="/courses/">歩き方を決める</a>
        <a class="btn-secondary final-cta__secondary" href="/faq/">出発前のよくある質問</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: max(720px, 100svh);
    overflow: hidden;
    background: #102c40;
    color: white;
  }

  .home-hero__image,
  .home-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__image {
    object-fit: cover;
    object-position: 50% 48%;
    animation: hero-breathe 18s ease-out both;
  }

  .home-hero__shade {
    background:
      linear-gradient(90deg, rgb(7 25 38 / 0.78) 0%, rgb(7 25 38 / 0.52) 37%, rgb(7 25 38 / 0.12) 72%),
      linear-gradient(0deg, rgb(7 25 38 / 0.72) 0%, transparent 42%),
      linear-gradient(180deg, rgb(7 25 38 / 0.25), transparent 28%);
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: max(720px, 100svh);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    padding-top: var(--header-height);
    padding-bottom: 7rem;
  }

  .home-hero__copy {
    max-width: 760px;
    padding-top: 3.5rem;
  }

  .hero-kicker {
    margin-bottom: 1.4rem;
    color: rgb(255 255 255 / 0.62);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.28em;
  }

  .home-hero h1,
  .home-hero .hero-title {
    margin-bottom: 0;
    font-family: var(--serif);
    font-size: clamp(3.4rem, 8.4vw, 8.5rem);
    font-weight: 500;
    letter-spacing: 0.035em;
    line-height: 1.13;
    text-shadow: 0 5px 35px rgb(0 0 0 / 0.18);
  }

  .home-hero h1 span,
  .home-hero .hero-title span {
    display: inline-block;
    padding-left: clamp(1rem, 6vw, 5.5rem);
  }

  .hero-lead {
    margin-top: 2rem;
    margin-bottom: 0;
    color: rgb(255 255 255 / 0.76);
    font-family: var(--serif);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    letter-spacing: 0.08em;
    line-height: 2;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.6rem;
  }

  .hero-primary {
    border-color: #faf8f2;
    background: #faf8f2;
    color: #173b57;
    box-shadow: 0 18px 45px rgb(0 0 0 / 0.18);
  }

  .hero-primary:hover {
    border-color: white;
    background: white;
  }

  .hero-secondary {
    border-color: rgb(255 255 255 / 0.34);
    background: rgb(16 44 64 / 0.16);
    color: white;
  }

  .hero-secondary:hover {
    border-color: white;
    background: rgb(16 44 64 / 0.44);
  }

  .home-hero__side {
    display: flex;
    height: 54%;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    border-left: 1px solid rgb(255 255 255 / 0.25);
    padding-left: 1.4rem;
  }

  .hero-coordinate {
    color: rgb(255 255 255 / 0.5);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.7;
    text-align: right;
  }

  .hero-bottom {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .hero-bottom__inner {
    display: flex;
    min-height: 74px;
    align-items: center;
    justify-content: space-between;
    color: rgb(255 255 255 / 0.48);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  .hero-bottom__inner a {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .hero-bottom__inner svg {
    width: 1rem;
    height: 1rem;
  }

  @keyframes hero-breathe {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }

  .facts-bar {
    position: relative;
    z-index: 4;
    margin-top: -1px;
    background: #faf8f2;
    box-shadow: 0 18px 70px rgb(16 44 64 / 0.06);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .fact-item {
