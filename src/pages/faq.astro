---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { faqItems, site } from "../data/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="竹島園地・竹島のよくある質問"
  description="竹島園地の料金、所要時間、アクセス、駐車場、車いす・ベビーカー、雨の日、水族館、御朱印、ペットなどの質問に回答。"
  image="/images/bridge-walk.webp"
  jsonLd={jsonLd}
>
  <PageHero
    title="出発前の、よくある質問。"
    lead="料金、所要時間、駐車場、雨の日、歩きやすさ。竹島へ行く前に知っておきたいことを、旅行者の目線でまとめました。"
    image="/images/bridge-walk.webp"
    imageAlt="竹島橋を歩いて島へ向かう人々"
    current="よくある質問"
    position="center 52%"
  />

  <section class="section-space-sm faq-intro">
    <div class="container-site faq-intro__grid">
      <SectionHeading
        eyebrow="FAQ"
        title="迷ったら、無理をしない選択へ。"
        lead="竹島は海辺の自然と神社を含む場所です。天候、祭事、施設運用は変わるため、このページの情報より現地表示と当日の案内を優先してください。"
      />
      <div class="faq-shortcuts" data-reveal>
        <a href="#faq-0">料金・所要時間</a>
        <a href="#faq-2">アクセス・駐車場</a>
        <a href="#faq-4">歩きやすさ</a>
        <a href="#faq-5">雨の日</a>
        <a href="#faq-6">写真</a>
        <a href="#faq-8">神社・御朱印</a>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container-narrow faq-list">
      {faqItems.map((item, index) => (
        <details id={`faq-${index}`} data-reveal>
          <summary>
            <span>Q{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.question}</strong>
            <i aria-hidden="true"></i>
          </summary>
          <div class="faq-answer"><span>A</span><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
    <p class="container-narrow faq-updated">確認日：{site.updatedAt}。料金、営業時間、交通、施設ルールは予告なく変更されることがあります。</p>
  </section>

  <section class="section-space faq-links-section">
    <div class="container-site">
      <SectionHeading eyebrow="PLAN YOUR VISIT" title="次に確認したいこと。" align="center" />
      <div class="faq-link-grid">
        <a href="/access/" data-reveal><span>01</span><h3>行き方・駐車場</h3><p>駅からの徒歩、自動車、料金目安、バリアフリー。</p><b>詳しく見る →</b></a>
        <a href="/courses/" data-reveal data-reveal-delay="1"><span>02</span><h3>モデルコース</h3><p>60〜90分、親子の半日、夕景の三つの歩き方。</p><b>詳しく見る →</b></a>
        <a href="/food/" data-reveal data-reveal-delay="2"><span>03</span><h3>周辺グルメ</h3><p>うどん、海鮮、ホテルランチと食事のタイミング。</p><b>詳しく見る →</b></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-intro { background: #faf8f2; }
  .faq-intro__grid { display: grid; grid-template-columns: 1fr .78fr; gap: clamp(3rem, 9vw, 8rem); align-items: end; }
  .faq-shortcuts { display: flex; flex-wrap: wrap; gap: .55rem; }
  .faq-shortcuts a { border: 1px solid rgb(23 59 87 / .14); border-radius: 999px; padding: .55rem .8rem; color: #173b57; font-size: .68rem; font-weight: 800; }
  .faq-shortcuts a:hover { background: #173b57; color: white; }

  .faq-section { background: #f3efe5; padding-bottom: clamp(5rem, 10vw, 9rem); }
  .faq-list { display: grid; }
  .faq-list details { border-top: 1px solid rgb(23 59 87 / .14); }
  .faq-list details:last-child { border-bottom: 1px solid rgb(23 59 87 / .14); }
  .faq-list summary { display: grid; grid-template-columns: 3.2rem 1fr 2rem; gap: 1rem; align-items: center; padding: 1.6rem 0; color: #173b57; cursor: pointer; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary > span { color: #b74632; font-size: .62rem; font-weight: 800; letter-spacing: .1em; }
  .faq-list summary strong { font-family: var(--serif); font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 600; }
  .faq-list summary i { position: relative; width: 1.6rem; height: 1.6rem; border: 1px solid rgb(23 59 87 / .18); border-radius: 50%; }
  .faq-list summary i::before,
  .faq-list summary i::after { position: absolute; top: 50%; left: 50%; width: .65rem; height: 1px; background: #173b57; content: ""; transform: translate(-50%, -50%); transition: transform 180ms ease; }
  .faq-list summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-list details[open] summary i::after { transform: translate(-50%, -50%) rotate(0); }
  .faq-answer { display: grid; grid-template-columns: 3.2rem 1fr; gap: 1rem; padding: 0 3rem 1.8rem 0; }
  .faq-answer > span { color: #315848; font-family: var(--serif); font-size: 1rem; }
  .faq-answer p { margin: 0; color: rgb(34 38 34 / .66); line-height: 2; }
  .faq-updated { margin-top: 1rem; color: rgb(34 38 34 / .43); font-size: .63rem; }

  .faq-links-section { background: #173b57; color: white; }
  .faq-links-section :global(.eyebrow) { color: #e7b7a9; }
  .faq-links-section :global(.section-title) { color: white; }
  .faq-link-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: clamp(3rem, 6vw, 5rem); }
  .faq-link-grid a { display: flex; min-height: 310px; flex-direction: column; border: 1px solid rgb(255 255 255 / .14); border-radius: 1.3rem; background: rgb(255 255 255 / .05); padding: 1.7rem; transition: transform 180ms ease, background 180ms ease; }
  .faq-link-grid a:hover { transform: translateY(-4px); background: rgb(255 255 255 / .09); }
  .faq-link-grid span { color: #e7b7a9; font-size: .62rem; font-weight: 800; letter-spacing: .14em; }
  .faq-link-grid h3 { margin: 1rem 0 .6rem; font-family: var(--serif); font-size: 1.4rem; font-weight: 500; }
  .faq-link-grid p { margin: 0; color: rgb(255 255 255 / .58); font-size: .75rem; line-height: 1.9; }
  .faq-link-grid b { margin-top: auto; color: white; font-size: .72rem; }

  @media (max-width: 820px) {
    .faq-intro__grid { grid-template-columns: 1fr; }
    .faq-link-grid { grid-template-columns: 1fr; }
    .faq-link-grid a { min-height: 230px; }
  }

  @media (max-width: 560px) {
    .faq-list summary { grid-template-columns: 2.4rem 1fr 1.6rem; gap: .6rem; }
    .faq-answer { grid-template-columns: 2.4rem 1fr; gap: .6rem; padding-right: 0; }
  }
</style>
