---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import LocalMap from "../components/LocalMap.astro";
import { site } from "../data/site";

const mapUrl = "https://www.google.com/maps/dir/?api=1&destination=34.8151165%2C137.2335325&destination_place_id=ChIJcWqk7SHHBGAQ69vhWpAZGrI";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Place",
  name: "竹島園地",
  address: {
    "@type": "PostalAddress",
    postalCode: "443-0031",
    addressRegion: "愛知県",
    addressLocality: "蒲郡市",
    streetAddress: "竹島町31",
    addressCountry: "JP"
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.coordinates.latitude,
    longitude: site.coordinates.longitude
  },
  publicAccess: true
};
---

<BaseLayout
  title="竹島園地へのアクセス・行き方と駐車場"
  description="JR蒲郡駅から竹島園地までの徒歩ルート、名古屋・豊橋からの電車、自動車、竹島園地駐車場の料金目安、バリアフリー情報。"
  image="/images/bridge-seaside.webp"
  jsonLd={jsonLd}
>
  <PageHero
    title="駅から海へ、約十五分。"
    lead="JR蒲郡駅南口から竹島園地へ。電車、徒歩、車の行き方と、到着後に迷わないための位置関係をまとめました。"
    image="/images/bridge-seaside.webp"
    imageAlt="竹島園地から竹島橋と海を望む風景"
    current="アクセス"
    position="center 60%"
  />

  <section class="section-space-sm access-summary">
    <div class="container-site summary-grid">
      <SectionHeading
        eyebrow="ACCESS SUMMARY"
        title="蒲郡駅、園地、橋、島。"
        lead="主要スポットは徒歩圏にまとまっています。駅から海へ向かい、水族館を過ぎると竹島園地と橋が見えてきます。"
      />
      <div class="summary-cards" data-reveal>
        <article><span>STATION</span><strong>JR蒲郡駅</strong><p>南口から徒歩約15分</p></article>
        <article><span>BUS</span><strong>竹島遊園</strong><p>路線バス約5分目安</p></article>
        <article><span>TAXI</span><strong>駅から約3分</strong><p>荷物や雨の日に便利</p></article>
        <article><span>PARKING</span><strong>普通車 約200台</strong><p>時期により有料</p></article>
      </div>
    </div>
  </section>

  <section class="map-section">
    <div class="container-site">
      <div data-reveal><LocalMap /></div>
      <div class="map-actions" data-reveal>
        <div><strong>{site.address}</strong><span>緯度 {site.coordinates.latitude}／経度 {site.coordinates.longitude}</span></div>
        <div>
          <button class="btn-secondary" type="button" data-copy-value={site.address}>住所をコピー</button>
          <a class="btn-primary" href={mapUrl} target="_blank" rel="noopener noreferrer">地図アプリで経路を開く</a>
        </div>
      </div>
      <div class="google-map" data-reveal>
        <div class="google-map__heading">
          <p class="eyebrow">LOCATION MAP</p>
          <h2>Googleマップで竹島園地を確認。</h2>
          <p>蒲郡駅、竹島水族館、駐車場との位置関係を確認してから、利用する交通手段と経路を選べます。</p>
        </div>
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3275.6352858056334!2d137.2335325!3d34.815116499999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6004c721eda46a71%3A0xb21a19905ae1dbeb!2z56u55bO25ZyS5Zyw!5e0!3m2!1sja!2sjp!4v1785403485939!5m2!1sja!2sjp"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="竹島園地のGoogleマップ"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section-space train-section" id="train">
    <div class="container-site">
      <SectionHeading
        eyebrow="BY TRAIN"
        title="電車なら、JR蒲郡駅へ。"
        lead="名古屋方面と豊橋方面のどちらからも東海道本線でアクセスできます。乗換や所要時間は列車種別と時間帯で変わります。"
      />
      <div class="train-routes">
        <article data-reveal>
          <div class="train-route__head"><span>FROM NAGOYA</span><strong>約45分目安</strong></div>
          <div class="train-route__line"><b>JR 名古屋駅</b><i></i><em>東海道本線<br />新快速・快速など</em><i></i><b>JR 蒲郡駅</b></div>
          <p>直通列車を選べる時間帯があります。運行状況と停車駅を当日に確認してください。</p>
        </article>
        <article data-reveal data-reveal-delay="1">
          <div class="train-route__head"><span>FROM TOYOHASHI</span><strong>約15分目安</strong></div>
          <div class="train-route__line"><b>JR 豊橋駅</b><i></i><em>東海道本線<br />快速・普通など</em><i></i><b>JR 蒲郡駅</b></div>
          <p>豊橋を拠点に東三河を巡る旅とも組み合わせやすい距離です。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-space airport-section" id="airport">
    <div class="container-site">
      <SectionHeading
        eyebrow="FROM THE AIRPORT"
        title="空港から、海へ。"
        lead="最寄りは中部国際空港（セントレア）。鉄道を乗り継いで蒲郡駅へ出て、あとは海へ向かうだけです。"
      />
      <div class="airport-routes">
        <article data-reveal>
          <div class="airport-route__head"><span>FROM CENTRAIR</span><strong>セントレア発 目安</strong></div>
          <div class="airport-route__line">
            <b>中部国際空港</b><i></i><em>名鉄空港線<br />特急で名鉄名古屋</em><i></i><b>JR蒲郡駅</b>
          </div>
          <p>名鉄空港線の特急で名鉄名古屋駅へ（約28分）、そこからJR東海道本線（快速で蒲郡駅まで約45分）。南口を出て徒歩約15分で竹島園地です。大型荷物があるなら駅からタクシーも検討を。</p>
        </article>
        <article data-reveal data-reveal-delay="1">
          <div class="airport-route__head"><span>FROM KOMAKI</span><strong>名古屋空港発 目安</strong></div>
          <div class="airport-route__line">
            <b>名古屋空港</b><i></i><em>連絡バスで<br />名古屋駅方面</em><i></i><b>JR蒲郡駅</b>
          </div>
          <p>名古屋空港（小牧）からは連絡バスで名古屋駅・栄方面へ出て、JR東海道本線で蒲郡駅へ。バスと電車の待ち時間を含め、余裕を持った日程で計画してください。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-space transit-section" id="bus-taxi">
    <div class="container-site transit-grid">
      <div class="transit-copy">
        <p class="eyebrow" data-reveal>BUS &amp; TAXI</p>
        <h2 class="section-title" data-reveal>駅からの、もう一歩。</h2>
        <p class="section-lead" data-reveal>
          蒲郡駅から園地までは平坦な道のりですが、荷物や雨、夜の帰りにはバスやタクシーが心強い味方になります。
        </p>
      </div>
      <div class="transit-cards" data-reveal>
        <article><span>路線バス</span><h3>名鉄バス「竹島遊園」</h3><p>蒲郡駅前から竹島遊園停留所まで約5分。運行本数と運賃は時期で変わるため、現地の案内を確認してください。</p></article>
        <article><span>タクシー</span><h3>蒲郡駅から約3分</h3><p>駅前のタクシー乗り場、または配車アプリで利用可。荷物や雨の日、夜の帰りに便利です。目安運賃は短距離のため現地でご確認を。</p></article>
        <article><span>レンタサイクル</span><h3>海辺をゆっくり</h3><p>自転車で海沿いを巡るのも一興です。貸出場所と返却条件は市街地の案内を確認してください。</p></article>
      </div>
    </div>
  </section>

  <section class="section-space walk-section" id="walk">
    <div class="container-site walk-grid">
      <div class="walk-copy">
        <p class="eyebrow" data-reveal>FROM THE STATION</p>
        <h2 class="section-title" data-reveal>蒲郡駅から、海へまっすぐ。</h2>
        <p class="section-lead" data-reveal>
          南口を出て竹島方面へ進みます。大きな高低差は少なく、約15分。途中から海の気配が近づき、水族館の先に園地と橋が見えます。
        </p>
        <ol class="walk-steps">
          <li data-reveal><span>01</span><div><h3>蒲郡駅 南口</h3><p>北口と間違えないよう、南口・竹島方面へ。</p></div></li>
          <li data-reveal><span>02</span><div><h3>竹島入口方面</h3><p>歩道を進み、交差点では案内表示と車に注意。</p></div></li>
          <li data-reveal><span>03</span><div><h3>竹島水族館</h3><p>水族館が見えたら、園地はすぐ近くです。</p></div></li>
          <li data-reveal><span>04</span><div><h3>竹島園地・竹島橋</h3><p>芝生側から全景を確認して散歩を始めます。</p></div></li>
        </ol>
      </div>
      <div class="walk-image image-frame" data-reveal><img src="/images/bridge-walk.webp" alt="竹島橋へ向かって歩く人々" loading="lazy" /></div>
    </div>
  </section>

  <section class="section-space car-section" id="car">
    <div class="container-site car-grid">
      <div>
        <p class="eyebrow" data-reveal>BY CAR</p>
        <h2 class="section-title" data-reveal>車は、混雑する時間を避けて。</h2>
        <p class="section-lead" data-reveal>
          東名高速道路・音羽蒲郡IC方面から約15〜20分が目安です。行楽期、潮干狩り、祭礼、花火などの日は周辺道路と駐車場が混み合います。
        </p>
      </div>
      <div class="car-routes" data-reveal>
        <article><span>01</span><h3>音羽蒲郡IC方面</h3><p>三河湾オレンジロード方面を経由して竹島へ。ナビの到着地は「竹島園地駐車場」周辺に。</p></article>
        <article><span>02</span><h3>国道23号方面</h3><p>蒲郡市街・竹島方面へ。休日は市街地の交差点と駐車場入口で余裕を持って。</p></article>
        <article><span>03</span><h3>イベント開催日</h3><p>満車、入庫制限、夜間閉鎖が起きることがあります。現地の誘導を優先してください。</p></article>
      </div>
    </div>
  </section>

  <section class="section-space parking-section" id="parking">
    <div class="container-site">
      <SectionHeading
        eyebrow="PARKING"
        title="竹島園地駐車場の目安。"
        lead="普通車約200台、大型車用区画があります。平日は原則無料ですが、春季や土日祝などは時期により有料です。"
      />
      <div class="parking-layout">
        <div class="parking-table-wrap" data-reveal>
          <table class="parking-table">
            <thead><tr><th>時期・曜日</th><th>普通車料金目安</th><th>備考</th></tr></thead>
            <tbody>
              <tr><th>平日</th><td>原則無料</td><td>特定期間・行事日は例外あり</td></tr>
              <tr><th>4月・5月の土日祝</th><td>500円</td><td>春の繁忙期</td></tr>
              <tr><th>4月27日〜5月8日頃の平日</th><td>500円</td><td>年度により運用確認</td></tr>
              <tr><th>その他の月の土日祝</th><td>300円</td><td>料金時間 9:00〜17:00目安</td></tr>
              <tr><th>大型バス</th><td>無料目安</td><td>約14台・事前確認推奨</td></tr>
            </tbody>
          </table>
        </div>
        <aside class="parking-notes" data-reveal data-reveal-delay="1">
          <h3>駐車前に確認したいこと</h3>
          <ul>
            <li>祭礼・花火・イベントによる利用制限</li>
            <li>料金徴収日と徴収時間</li>
            <li>満車時の誘導と代替駐車場</li>
            <li>大型車・電気自動車の利用条件</li>
            <li>夜間の出庫可否と周辺の安全</li>
          </ul>
          <p>料金・台数・運用は変更される場合があります。掲示と係員の案内を優先してください。</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-space barrier-section" id="barrier-free">
    <div class="container-site barrier-grid">
      <div class="barrier-image image-frame" data-reveal><img src="/images/torii-bridge.webp" alt="鳥居から竹島橋へ続く平坦な道" loading="lazy" /></div>
      <div class="barrier-copy">
        <p class="eyebrow" data-reveal>BARRIER-FREE NOTES</p>
        <h2 class="section-title" data-reveal>行けるところまでで、<br />竹島は楽しめる。</h2>
        <p class="section-lead" data-reveal>
          園地と橋は比較的平坦ですが、島内の神社へは石段があり、外周は自然の岩場や段差を含みます。全員が島を一周しなくても、園地、橋前、水族館で海辺の時間を楽しめます。
        </p>
        <dl class="barrier-list" data-reveal>
          <div><dt>車いす・ベビーカー</dt><dd>園地、橋詰、橋の状況を見て無理のない範囲へ。</dd></div>
          <div><dt>竹島水族館</dt><dd>館内は単層でバリアフリー案内があります。</dd></div>
          <div><dt>休憩</dt><dd>園地のベンチや芝生、周辺施設を活用。</dd></div>
          <div><dt>介助</dt><dd>強風時は橋上の移動負担が増すため、予定を変更。</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section-space before-section" id="before-you-go">
    <div class="container-site before-card">
      <div>
        <p class="eyebrow" data-reveal>BEFORE YOU GO</p>
        <h2 class="section-title" data-reveal>出発前の五分で、<br />旅を軽くする。</h2>
      </div>
      <div class="before-checks">
        <label data-reveal><input type="checkbox" /><span><strong>天気と風</strong>橋上と海辺は市街地より風を感じます。</span></label>
        <label data-reveal><input type="checkbox" /><span><strong>歩きやすい靴</strong>石段と岩場へ行くなら滑りにくい靴を。</span></label>
        <label data-reveal><input type="checkbox" /><span><strong>営業時間</strong>水族館、食事、社務所の受付を確認。</span></label>
        <label data-reveal><input type="checkbox" /><span><strong>駐車場・行事</strong>祭礼やイベントの日程と規制を確認。</span></label>
        <label data-reveal><input type="checkbox" /><span><strong>帰りの交通</strong>夕景を見る日は時刻表と明るさを先に確認。</span></label>
      </div>
    </div>
    <p class="container-site updated-note">情報確認日：{site.updatedAt}。運行、料金、道路、施設の状況は当日変更されることがあります。</p>
  </section>
</BaseLayout>

<style>
  .access-summary { background: #faf8f2; }
  .summary-grid { display: grid; grid-template-columns: 1fr .88fr; gap: clamp(3rem, 9vw, 8rem); align-items: end; }
  .summary-cards { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid rgb(23 59 87 / .1); border-radius: 1.3rem; background: #f3efe5; }
  .summary-cards article { padding: 1.2rem; border-right: 1px solid rgb(23 59 87 / .1); border-bottom: 1px solid rgb(23 59 87 / .1); }
  .summary-cards article:nth-child(2n) { border-right: 0; }
  .summary-cards article:nth-child(n + 3) { border-bottom: 0; }
  .summary-cards span { color: #b74632; font-size: .56rem; font-weight: 800; letter-spacing: .16em; }
  .summary-cards strong { display: block; margin-top: .3rem; color: #173b57; font-family: var(--serif); font-size: 1rem; }
  .summary-cards p { margin: .15rem 0 0; color: rgb(34 38 34 / .5); font-size: .68rem; }

  .map-section { background: #eef0e8; padding-block: clamp(4rem, 8vw, 7rem); }
  .map-actions { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 1rem; border: 1px solid rgb(23 59 87 / .1); border-radius: 1.2rem; background: rgb(250 248 242 / .75); padding: 1.2rem 1.4rem; }
  .map-actions > div:first-child { display: grid; }
  .map-actions strong { color: #173b57; font-family: var(--serif); font-size: .95rem; }
  .map-actions span { color: rgb(34 38 34 / .45); font-size: .62rem; }
  .map-actions > div:last-child { display: flex; flex: 0 0 auto; gap: .6rem; }
  .google-map { overflow: hidden; margin-top: clamp(2.5rem, 6vw, 5rem); border: 1px solid rgb(23 59 87 / .1); border-radius: 1.5rem; background: #faf8f2; }
  .google-map__heading { max-width: 760px; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .google-map__heading h2 { margin: .65rem 0 0; color: #173b57; font-family: var(--serif); font-size: clamp(1.55rem, 3vw, 2.35rem); font-weight: 500; }
  .google-map__heading > p:last-child { margin: .8rem 0 0; color: rgb(34 38 34 / .58); font-size: .78rem; line-height: 1.9; }
  .google-map iframe { display: block; width: 100%; height: clamp(360px, 52vw, 600px); }

  .train-section { background: #faf8f2; }
  .train-routes { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: clamp(3rem, 6vw, 5rem); }
  .train-routes article { border: 1px solid rgb(23 59 87 / .1); border-radius: 1.4rem; background: #f3efe5; padding: clamp(1.5rem, 3vw, 2.5rem); }
  .train-route__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .train-route__head span { color: #b74632; font-size: .58rem; font-weight: 800; letter-spacing: .17em; }
  .train-route__head strong { color: #173b57; font-family: var(--serif); font-size: .9rem; }
  .train-route__line { display: grid; grid-template-columns: auto 1fr auto 1fr auto; gap: .7rem; align-items: center; margin: 2rem 0; }
  .train-route__line b { color: #173b57; font-family: var(--serif); font-size: .88rem; white-space: nowrap; }
  .train-route__line i { height: 2px; background: #6fa9bf; position: relative; }
  .train-route__line i::after { position: absolute; right: -1px; top: 50%; width: 7px; height: 7px; border-top: 2px solid #6fa9bf; border-right: 2px solid #6fa9bf; content: ""; transform: translateY(-50%) rotate(45deg); }
  .train-route__line em { color: rgb(34 38 34 / .48); font-size: .6rem; font-style: normal; line-height: 1.5; text-align: center; }
  .train-routes article > p { margin: 0; color: rgb(34 38 34 / .58); font-size: .72rem; line-height: 1.8; }

  .walk-section { background: #dfecef; }
  .walk-grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(3rem, 9vw, 8rem); align-items: center; }
  .walk-steps { margin: 2rem 0 0; padding: 0; list-style: none; }
  .walk-steps li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; border-top: 1px solid rgb(23 59 87 / .13); padding: .9rem 0; }
  .walk-steps li:last-child { border-bottom: 1px solid rgb(23 59 87 / .13); }
  .walk-steps > li > span { color: #b74632; font-size: .62rem; font-weight: 800; letter-spacing: .14em; }
  .walk-steps h3 { margin-bottom: .2rem; color: #173b57; font-family: var(--serif); font-size: 1rem; }
  .walk-steps p { margin: 0; color: rgb(34 38 34 / .58); font-size: .72rem; }
  .walk-image { height: clamp(520px, 62vw, 740px); border-radius: 10rem 1.5rem 1.5rem 1.5rem; }

  .car-section { background: #173b57; color: white; }
  .car-grid { display: grid; grid-template-columns: .85fr 1fr; gap: clamp(3rem, 9vw, 8rem); }
  .car-section :global(.eyebrow) { color: #e7b7a9; }
  .car-section :global(.section-title) { color: white; }
  .car-section :global(.section-lead) { color: rgb(255 255 255 / .62); }
