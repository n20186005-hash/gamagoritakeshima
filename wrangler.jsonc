{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gamagoritakeshima",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
